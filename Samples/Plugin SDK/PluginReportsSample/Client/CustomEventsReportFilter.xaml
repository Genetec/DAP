<pages:ReportFilter
    x:Class="Genetec.Dap.CodeSamples.Client.CustomEventsReportFilter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="clr-namespace:Genetec.Sdk.Workspace.Pages;assembly=Genetec.Sdk.Workspace">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Label Margin="0,5,10,5" Content="Custom event" Padding="0"
               HorizontalAlignment="Right" VerticalAlignment="Center"
               Style="{Styles {x:Static LabelStyles.Intro}}" />
        <ComboBox Grid.Column="1" Margin="0,5"
                  ItemsSource="{Binding Events}" DisplayMemberPath="Name"
                  SelectedItem="{Binding SelectedEvent, Mode=TwoWay}" />
        <Label Grid.Row="1" Margin="0,5,10,5" Content="Message contains" Padding="0"
               HorizontalAlignment="Right" VerticalAlignment="Center"
               Style="{Styles {x:Static LabelStyles.Intro}}" />
        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,5"
                 Text="{Binding Message, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <Label Grid.Row="2" Grid.ColumnSpan="2" Padding="0" Margin="0,4"
               Style="{Styles {x:Static LabelStyles.Normal}}">
            <TextBlock TextWrapping="Wrap" Text="Entity types come from the custom-event definitions. Reopen this task after adding or changing definitions. Leave the message empty to match any message." />
        </Label>
    </Grid>
</pages:ReportFilter>
