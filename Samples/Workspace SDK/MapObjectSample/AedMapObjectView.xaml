<maps:MapObjectView x:Class="Genetec.Dap.CodeSamples.AedMapObjectView"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:maps="clr-namespace:Genetec.Sdk.Workspace.Maps;assembly=Genetec.Sdk.Workspace"
                    x:Name="Marker" Width="54" Height="44" Margin="-27,-22,0,0"
                    Loaded="OnLoaded" Unloaded="OnUnloaded">
    <maps:MapObjectView.Resources>
        <Style TargetType="TextBlock" />
        <Style TargetType="Border" x:Key="SelectionBorder">
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, ElementName=Marker}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </maps:MapObjectView.Resources>
    <Border Style="{StaticResource SelectionBorder}" BorderThickness="3" CornerRadius="8" Padding="2">
        <Border x:Name="MarkerBody" BorderBrush="White" BorderThickness="1" CornerRadius="4">
            <Grid>
                <TextBlock Text="AED" FontSize="15" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock x:Name="MarkerIndicator" FontSize="10" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,2,0" />
            </Grid>
        </Border>
    </Border>
</maps:MapObjectView>
