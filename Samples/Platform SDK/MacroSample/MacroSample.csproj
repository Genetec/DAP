<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Base target framework - always supported -->
		<TargetFramework>net481</TargetFramework>
		<TargetFramework Condition="'$(Configuration)' == 'Debug_NET8' OR '$(Configuration)' == 'Release_NET8'">net8.0-windows</TargetFramework>
		<TargetFramework Condition="'$(Configuration)' == 'Debug_NET10' OR '$(Configuration)' == 'Release_NET10'">net10.0-windows</TargetFramework>
		<Configurations>Debug;Release;Debug_NET8;Release_NET8;Debug_NET10;Release_NET10</Configurations>
		<RootNamespace>Genetec.Dap.CodeSamples</RootNamespace>
		<AssemblyName>MacroSample</AssemblyName>
		<Description>Sample project</Description>
		<Copyright>Copyright © Genetec Inc. 2024</Copyright>
		<OutputType>Exe</OutputType>
	</PropertyGroup>

	<Import Project="..\PlatformSamples.props" />

	<ItemGroup Condition="'$(TargetFramework)' == 'net481'">
		<Reference Include="Genetec.Sdk">
			<HintPath>$(GSC_SDK)\Genetec.Sdk.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Genetec.Sdk.Scripting.Compiler">
			<HintPath>$(GSC_SDK)\Genetec.Sdk.Scripting.Compiler.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Genetec.Sdk.Scripting.Interfaces">
			<HintPath>$(GSC_SDK)\Genetec.Sdk.Scripting.Interfaces.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="System" />
		<Reference Include="System.Core" />
		<Reference Include="System.Data.DataSetExtensions" />
		<PackageReference Include="System.ValueTuple" Version="4.6.1" GeneratePathProperty="true" />
		<None Include="$(PkgSystem_ValueTuple)\lib\net462\System.ValueTuple.dll"
		      Link="System.ValueTuple.dll"
		      CopyToOutputDirectory="PreserveNewest"
		      CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows' OR '$(TargetFramework)' == 'net10.0-windows'">
		<Reference Include="Genetec.Sdk.Scripting.Compiler">
			<HintPath>$(GSC_SDK_CORE)\Genetec.Sdk.Scripting.Compiler.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Genetec.Sdk.Scripting.Interfaces">
			<HintPath>$(GSC_SDK_CORE)\Genetec.Sdk.Scripting.Interfaces.dll</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>

	<Import Project="..\..\Shared\Shared.projitems" Label="Shared" />


</Project>
