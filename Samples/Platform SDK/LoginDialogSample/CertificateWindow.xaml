<Window x:Class="Genetec.Dap.CodeSamples.CertificateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verify Directory certificate" Width="470" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24">
    <TextBlock Text="Verify this certificate with your administrator before trusting the Directory."
               TextWrapping="Wrap" />
    <TextBlock x:Name="Warnings" Foreground="#FFD280" TextWrapping="Wrap" Margin="0,12,0,12" />
    <TextBox x:Name="Details" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="260" VerticalScrollBarVisibility="Auto" />
    <TextBlock Text="Acceptance can be remembered by Security Center for this Windows user on this computer."
               TextWrapping="Wrap" Margin="0,12,0,0" />
    <Button x:Name="TrustButton" Content="Trust and continue" Click="OnTrustClicked" Margin="0,20,0,0" />
    <Button Content="Cancel" IsCancel="True" IsDefault="True" Style="{StaticResource LinkButton}" />
  </StackPanel>
</Window>
