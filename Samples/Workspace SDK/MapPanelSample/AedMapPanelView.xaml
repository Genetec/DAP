<UserControl x:Class="Genetec.Dap.CodeSamples.AedMapPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Refresh" Click="OnRefresh"
                    Style="{Styles {x:Static ButtonStyles.Default}}" Margin="8,0,0,0" />
            <Label x:Name="MapNameText" Content="AEDs on this map" Padding="0"
                   Style="{Styles {x:Static LabelStyles.Normal}}" FontWeight="SemiBold" />
        </DockPanel>
        <Label Grid.Row="1" x:Name="SummaryText" Padding="0" Margin="0,0,0,8"
               Style="{Styles {x:Static LabelStyles.Normal}}" />
        <ListBox Grid.Row="2" x:Name="AedList" SelectionMode="Single" SelectionChanged="OnAedSelected"
                  HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4" ToolTip="{Binding Summary}">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Status}" Margin="0,4,0,0" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Label Grid.Row="3" Padding="0" Margin="0,10,0,0" Style="{Styles {x:Static LabelStyles.Normal}}">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        </Label>
    </Grid>
</UserControl>
