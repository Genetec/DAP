<Window x:Class="Genetec.Dap.CodeSamples.PasswordChangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change password" Width="354" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24">
    <TextBlock Text="Security Center requires a new password to complete logon." TextWrapping="Wrap" />
    <TextBlock x:Name="Error" TextWrapping="Wrap" Foreground="#FFAAAA" Margin="0,8,0,0"
               Style="{StaticResource Feedback}" AutomationProperties.LiveSetting="Assertive" />
    <Label Content="_New password:" Target="{Binding ElementName=NewPasswordInput}" />
    <PasswordBox x:Name="NewPasswordInput" AutomationProperties.AutomationId="NewPasswordInput" />
    <Label Content="_Confirm password:" Target="{Binding ElementName=ConfirmationInput}" />
    <PasswordBox x:Name="ConfirmationInput" AutomationProperties.AutomationId="ConfirmationInput" />
    <Button Content="Change password" IsDefault="True" Click="OnChangePasswordClicked" Margin="0,20,0,0" />
    <Button Content="Cancel" IsCancel="True" Style="{StaticResource LinkButton}" />
  </StackPanel>
</Window>
