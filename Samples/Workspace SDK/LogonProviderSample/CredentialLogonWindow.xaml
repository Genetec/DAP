<Window x:Class="Genetec.Dap.CodeSamples.CredentialLogonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Security Center logon" Width="470" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
        Closing="OnClosing" Loaded="OnLoaded">
    <Window.Resources>
        <!-- Keep this standalone dialog independent of implicit styles in the client.
             Use system brushes so Windows high-contrast settings still apply. -->
        <Style TargetType="{x:Type TextBlock}" />
        <Style TargetType="{x:Type AccessText}" />
        <Style TargetType="{x:Type Label}">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
        </Style>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
        </Style>
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
        </Style>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,0" />
        </Style>
        <Style TargetType="{x:Type PasswordBox}">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,0" />
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Windows Credential Manager" FontSize="20" Margin="0,0,0,16" />
        <Label Grid.Row="1" Target="{Binding ElementName=DirectoryBox}" Content="_Directory" Padding="0,0,0,4" />
        <TextBox Grid.Row="2" x:Name="DirectoryBox" MinHeight="28" AutomationProperties.AutomationId="Directory" />
        <CheckBox Grid.Row="3" x:Name="UseSavedBox" Content="_Use saved credential for this Directory"
                  Margin="0,12,0,12" Checked="OnUseSavedChanged" Unchecked="OnUseSavedChanged" />
        <StackPanel Grid.Row="4" x:Name="ManualCredentials">
            <Label Target="{Binding ElementName=UsernameBox}" Content="_Username" Padding="0,0,0,4" />
            <TextBox x:Name="UsernameBox" MinHeight="28" AutomationProperties.AutomationId="Username" />
            <Label Target="{Binding ElementName=PasswordBox}" Content="_Password" Padding="0,10,0,4" />
            <PasswordBox x:Name="PasswordBox" MinHeight="28" AutomationProperties.AutomationId="Password" />
        </StackPanel>
        <CheckBox Grid.Row="5" x:Name="SaveBox" Content="_Save credential after successful logon" Margin="0,12,0,0" />
        <TextBlock Grid.Row="6" x:Name="StatusText" TextWrapping="Wrap" Margin="0,16,0,0"
                   AutomationProperties.AutomationId="Status" AutomationProperties.LiveSetting="Polite" />
        <Button Grid.Row="7" x:Name="ForgetButton" Content="_Forget saved credential" HorizontalAlignment="Left"
                Margin="0,12,0,0" Padding="8,4" Click="OnForget" />
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="ConnectButton" Content="_Connect" IsDefault="True" MinWidth="95" Padding="8,6" Click="OnConnect" />
            <Button Content="_Cancel" IsCancel="True" MinWidth="95" Margin="8,0,0,0" Padding="8,6" Click="OnCancel" />
        </StackPanel>
        <TextBlock Grid.Row="9" Text="Saved credentials are available to this Windows user on this computer."
                   TextWrapping="Wrap" Margin="0,16,0,0" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
    </Grid>
</Window>
