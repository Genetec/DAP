<sdk:CustomWindow
    x:Class="Genetec.Dap.CodeSamples.CustomWindowSampleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sdk="clr-namespace:Genetec.Sdk.Controls;assembly=Genetec.Sdk.Controls"
    Title="CustomWindow sample"
    Width="460"
    Height="240"
    MinWidth="360"
    MinHeight="230"
    CanMaximize="False"
    CanMinimize="False"
    FocusManager.FocusedElement="{Binding ElementName=displayNameTextBox}"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Label
            Margin="0,0,0,4"
            Content="Display name"
            Target="{Binding ElementName=displayNameTextBox}"
            Style="{Styles {x:Static LabelStyles.Intro}}" />
        <TextBox
            x:Name="displayNameTextBox"
            Grid.Row="1"
            MinWidth="200" />

        <StackPanel Grid.Row="3" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button
                MinWidth="80"
                Margin="0,0,8,0"
                Click="OnOkClicked"
                Content="OK"
                IsDefault="True"
                Style="{Styles {x:Static ButtonStyles.Default}}" />
            <Button
                MinWidth="80"
                Content="Cancel"
                IsCancel="True"
                Style="{Styles {x:Static ButtonStyles.Default}}" />
        </StackPanel>
    </Grid>
</sdk:CustomWindow>
